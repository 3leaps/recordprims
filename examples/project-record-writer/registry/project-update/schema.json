{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "example-project-records/project-update/v1",
  "title": "Project update",
  "description": "A dated observation about a project: a summary, a status, and optional exact references to runs or evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "status", "observed_at"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "status": {"enum": ["on_track", "at_risk", "blocked", "done"]},
    "observed_at": {"$ref": "#/$defs/instant"},
    "references": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{6}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["document", "run", "evidence", "record"]},
        "ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
