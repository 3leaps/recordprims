{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-records/decision/v1",
  "title": "Project decision",
  "description": "A decision, its rationale, the authority that made it, and its evidence or an explicit statement that there is none. A reversal names the decision it reverses by exact pin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "decision", "rationale", "authority", "decided_at"],
  "oneOf": [
    {"required": ["evidence"], "not": {"required": ["evidence_absent"]}},
    {"required": ["evidence_absent"], "not": {"required": ["evidence"]}}
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "decision": {"type": "string", "minLength": 1, "maxLength": 4000},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/reference"}},
    "evidence_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 500}}
    },
    "decided_at": {"$ref": "#/$defs/instant"},
    "reverses": {"$ref": "#/$defs/pin"}
  },
  "$defs": {
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{6}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["document", "run", "evidence", "record"]},
        "ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "record_id", "revision", "digest"],
      "properties": {
        "stream": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
