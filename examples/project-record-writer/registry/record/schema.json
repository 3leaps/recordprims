{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "example-project-records/record/v1",
  "title": "Example project record",
  "description": "The stored payload of every record this example writes: the project, the exact descriptor revision the entry was checked under, the entry's own contract, and the entry. The entry is checked separately against the schema its descriptor pins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "descriptor", "entry_contract", "entry"],
  "properties": {
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner", "revision", "digest"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "entry_contract": {"type": "string", "pattern": "^contract: [a-z0-9][a-z0-9-]*/v[0-9]+$"},
    "entry": {"type": "object"}
  }
}
